<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Offline-only POC harness:
        - ZERO INTERNET permission (network access is blocked at OS level).
        - ZERO broad storage permissions (uses Android Photo Picker + app-private external files dir).
    -->
    <application
        android:allowBackup="false"
        android:label="@string/poc_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
